# Copy to .env and fill in.

# Webshare: all proxies are pulled from the API once, when the container starts.
# Key: dashboard.webshare.io -> API -> Keys.
WEBSHARE_API_KEY=
WEBSHARE_PLAN=static_residential   # or proxy_server, a numeric plan id, or empty for the account default
WEBSHARE_MODE=direct    # or "backbone" for rotating residential plans

# Extra/manual proxies (optional): comma-separated, or one per line in a file at PROXIES_FILE.
# No proxies at all = direct connection from the container's IP (same limits apply).
# PROXIES=http://user:pass@1.2.3.4:8080,http://user:pass@5.6.7.8:8080
# PROXIES_FILE=/run/proxies.txt

PAGES_PER_PROXY=10      # pages one IP loads before resting
COOLDOWN_SECONDS=60     # rest after hitting the quota (or after a block/error)
DELAY_MIN=1             # random delay between pages on the same IP
DELAY_MAX=2
MAX_CONCURRENCY=20      # proxies used in parallel; each ~100-150MB RAM (20 = ~2-3GB)
MAX_RETRIES=1           # retry a failed page on another proxy
MAX_PAGES_PER_REQUEST=500

# API_KEY=change-me     # when set, clients must send header X-API-Key
